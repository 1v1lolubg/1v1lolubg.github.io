---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const requestedCategory = Astro.url.searchParams.get('category');

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(allPosts.map((p) => p.data.category))];

const posts = requestedCategory
  ? allPosts.filter((p) => p.data.category === requestedCategory)
  : allPosts;
---

<BaseLayout
  title="Blog Archive"
  description="Browse every article on The Orange Desk, filterable by category — personal finance, technology, and practical everyday guides."
>
  <div class="container-page py-8">
    <Breadcrumbs items={[{ label: 'Blog' }]} />
  </div>

  <section class="container-page pb-16">
    <h1 class="mb-2 font-serif text-3xl font-semibold text-slate-900 sm:text-4xl">Blog Archive</h1>
    <p class="mb-8 max-w-2xl text-slate-600">Every article we've published, newest first.</p>

    <div class="mb-8 flex flex-wrap gap-3">
      <a href="/blog" class={`pill ${!requestedCategory ? '!bg-orange-600 !text-white !border-orange-600' : ''}`}>All</a>
      {
        categories.map((cat) => (
          <a
            href={`/blog?category=${encodeURIComponent(cat)}`}
            class={`pill ${requestedCategory === cat ? '!bg-orange-600 !text-white !border-orange-600' : ''}`}
          >
            {cat}
          </a>
        ))
      }
    </div>

    {
      posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-slate-500">No articles found in this category yet.</p>
      )
    }
  </section>
</BaseLayout>
